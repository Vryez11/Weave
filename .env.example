# 서비스 실행에 필요한 비밀 값의 이름과 설명. 이 파일을 복사해 `.env`를 만들고 값을 채운다. `.env`는 커밋하지 않는다.

# like-service MySQL 접속 정보 (like-service application.yml의 spring.datasource.*)
# 로컬에서는 `./gradlew :like-service:bootTestRun`이 Testcontainers MySQL을 띄우므로 채우지 않아도 된다.
# JDBC URL. 예) jdbc:mysql://localhost:3306/weave_like
# `docker compose`는 이 값을 쓰지 않고 compose.yaml에 적힌 jdbc:mysql://mysql:3306/weave_like로 붙는다.
LIKE_DB_URL=
# MySQL 사용자 이름. `docker compose`는 MySQL을 처음 띄울 때 이 이름으로 like-service 사용자를 만든다
LIKE_DB_USERNAME=
# MySQL 비밀번호. `docker compose`는 위 사용자의 비밀번호로 쓴다
LIKE_DB_PASSWORD=

# `docker compose`의 MySQL root 비밀번호. 서비스는 쓰지 않는다
# 계정은 MySQL 데이터 볼륨을 처음 만들 때만 정해진다. 값을 바꿨으면 `docker compose down -v`로 볼륨을 지우고 다시 띄운다
MYSQL_ROOT_PASSWORD=
